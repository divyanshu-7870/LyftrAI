# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here

# SQLite location, e.g. sqlite:////data/app.db (for Docker) or sqlite:///./data/app.db (for local)
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the failover test hook (X-Simulate-Failure header)
ENABLE_FAILURE_SIMULATION=true

# Model name for LiteLLM
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Default system prompt (optional fallback)
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.
